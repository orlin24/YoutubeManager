[Unit]
Description=AI YouTube Manager (FastAPI backend + SPA)
# Template: ganti __APP_DIR__ (mis. /opt/ai-youtube-manager) dan USER bila perlu.
# Installer otomatis (scripts/install.sh) menulis unit final ke /etc/systemd/system.
After=network.target
Wants=network.target

[Service]
Type=simple
User=aym
Group=aym
WorkingDirectory=__APP_DIR__/backend
EnvironmentFile=__APP_DIR__/backend/.env
ExecStart=__APP_DIR__/backend/.venv/bin/gunicorn app.main:app -k uvicorn.workers.UvicornWorker -w 1 -b 0.0.0.0:5000 --timeout 120
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
# Hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
