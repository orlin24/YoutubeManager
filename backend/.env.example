# AI YouTube Manager - environment variables
# Copy to backend/.env and fill in real values. NEVER commit .env to git.

APP_NAME=AI YouTube Manager
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=5000
APP_ORIGINS=http://localhost:5173,http://localhost:5000

# PostgreSQL (production). Example:
# DATABASE_URL=postgresql+psycopg://aym:CHANGE_ME@localhost:5432/ai_youtube_manager
DATABASE_URL=postgresql+psycopg://localhost:5432/ai_youtube_manager

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Optional; if empty, derived from SECRET_KEY (Fernet-compatible key)
TOKEN_ENCRYPTION_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google Cloud OAuth (see docs/GOOGLE_CLOUD_SETUP.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# AI provider (OpenAI-compatible API). Set AI_API_KEY to enable AI features.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

REDIS_URL=

# Where the browser is redirected after Google OAuth
FRONTEND_URL=http://localhost:5000

LOG_LEVEL=INFO
